# Choose ollama for local inference, or gemini / openai for hosted API usage.
SERA_AI_PROVIDER=ollama
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OPENAI_API_KEY=replace_with_your_private_key
OPENAI_MODEL=gpt-4.1-mini
# Optional: isolate saved lists in a different local folder.
# SERA_DATA_DIR=/absolute/path/to/private/sera-data

# Optional hosted Gemini provider. Keep the real key out of Git.
# SERA_AI_PROVIDER=gemini
GEMINI_API_KEY=replace_with_your_private_key
GEMINI_MODEL=gemini-3.5-flash-lite
# Public hosting uses private per-visit shortlists instead of a shared file.
# SERA_PUBLIC_DEMO=true
# SERA_PUBLIC_AI_SESSION_LIMIT=10
# SERA_PUBLIC_AI_DAILY_LIMIT=100
